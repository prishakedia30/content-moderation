{
 "uid": "moderation",
 "title": "Content moderation",
 "tags": [
  "moderation"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "current": {},
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "type": "stat",
   "title": "Posts / s",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(moderation_decisions_total{source!=\"video\"}[1m]))"
    }
   ],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Inference p95",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 4
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(moderation_inference_seconds_bucket[2m])))"
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Text-worker pods",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_deployment_status_replicas_available{deployment=\"text-worker\"})"
    }
   ],
   "id": 3
  },
  {
   "type": "stat",
   "title": "Queue waiting",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "graphMode": "area",
    "colorMode": "value"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(moderation_queue_lag{stream=\"posts.raw\"})"
    }
   ],
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Decisions per second",
   "description": "ALLOW / REVIEW / BLOCK rate from the API and the queue (video span checks excluded)",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (decision) (rate(moderation_decisions_total{source!=\"video\"}[1m]))",
     "legendFormat": "{{decision}}"
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Inference latency (model only)",
   "description": "Target: p95 under 50 ms",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum by (le) (rate(moderation_inference_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(moderation_inference_seconds_bucket[1m])))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(moderation_inference_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Autoscaling: text-worker pods",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(kube_deployment_status_replicas_available{deployment=\"text-worker\"})",
     "legendFormat": "running"
    },
    {
     "refId": "B",
     "expr": "sum(kube_horizontalpodautoscaler_status_desired_replicas{horizontalpodautoscaler=\"text-worker\"})",
     "legendFormat": "wanted by HPA"
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Text-worker CPU per pod (cores)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container=\"text-worker\"}[1m]))",
     "legendFormat": "{{pod}}"
    }
   ],
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "API request latency via ingest",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(ingest_request_seconds_bucket[1m])))",
     "legendFormat": "p95 {{endpoint}}"
    }
   ],
   "id": 9
  },
  {
   "type": "timeseries",
   "title": "Queue backlog",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (stream) (moderation_queue_lag)",
     "legendFormat": "{{stream}}"
    }
   ],
   "id": 10
  },
  {
   "type": "timeseries",
   "title": "Videos processed",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (increase(videos_processed_total[10m]))",
     "legendFormat": "{{status}}"
    }
   ],
   "id": 11
  },
  {
   "type": "timeseries",
   "title": "Errors",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (where) (rate(moderation_errors_total[5m]))",
     "legendFormat": "{{where}}"
    },
    {
     "refId": "B",
     "expr": "sum by (status) (rate(ingest_requests_total{status=~\"5..\"}[5m]))",
     "legendFormat": "ingest {{status}}"
    }
   ],
   "id": 12
  }
 ]
}